{
  "name": "kana-viewer",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm format:check && pnpm build"
  },
  "dependencies": {
    "harfbuzzjs": "1.6.4",
    "opentype.js": "2.0.0",
    "wawoff2": "2.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "7.3.1"
  }
}
